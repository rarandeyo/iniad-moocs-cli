# e2e テスト用 env 変数のテンプレート。
# 実際に走らせるときは source して export し、cargo test で実行する。
#
# 既定 (env 一切セットなし) ではすべての HTTP / 認証必要テストが
# `[skip] ... env XXX not set` ログ + early return で ok 扱いになる。
# destructive 系は `#[ignore]` で更に skip されるので、`-- --ignored` 必須。

# ---- 認証 (G3 keyring + G4 read-only HTTP + G5 destructive + G6 lesson) ----
export IMOOCS_E2E_USERNAME=s1f10TESTxxx       # MOOCs ID (例)
export IMOOCS_E2E_PASSWORD=...                # MOOCs パスワード (--password-stdin で食わせる)

# ---- 年度 + コース + 課題 (G5 destructive + G6 lesson) ----
export IMOOCS_E2E_YEAR=2026                   # MOOCs の年度 (resolve_latest_year を回避)
export IMOOCS_E2E_COURSE_ID=INI301            # 履修中コース
export IMOOCS_E2E_PROBLEM_ID=...              # 提出可能な課題 ID
export IMOOCS_E2E_PROBLEM_PID=p1              # 課題内の field pid

# ---- lesson best-effort (G6) ----
export IMOOCS_E2E_LESSON_URL=https://moocs.iniad.org/courses/2026/INI301/AI-s02/09
# ↑ slide 埋め込みのあるページにすること (10.3 で skipped を観察するため)

# ---- 認証必要 read-only (G4) ----
export IMOOCS_E2E_KEYRING_BOOTSTRAPPED=1      # bare imoocs() で実環境 keyring を引き継ぐ宣言

# ---- destructive 二重 opt-in (G5) ----
export IMOOCS_E2E_ALLOW_DESTRUCTIVE=1         # これを 1 にしないと destructive は skip
# 実行: cargo test -p imoocs-cli --test e2e -- --ignored
